{
  "private": true,
  "name": "my-app",
  "version": "1.0.0",
  "description": "npm init template for bootstrapping an empty Colyseus project",
  "main": "build/index.js",
  "engines": {
    "node": ">= 16.13.0"
  },
  "scripts": {
    "start-client": "vite serve src/client --config vite.config.ts --host",
    "start-server": "tsx watch src/server/index.ts",
    "start-character-tools": "vite serve src/tools/json/ui/ --config vite.config.ts",
    "loadtest": "tsx loadtest/example.ts --room my_room --numClients 2",
    "build-server": "npm run clean && tsc && tsc-alias",
    "clean": "rimraf build",
    "test": "mocha -r tsx test/**_test.ts --exit --timeout 15000",
    "migrate": "npx tsx ./src/server/mongodb/migrations/index.ts",
    "codegen-aseprite": "npx tsx src/tools/codegen/aseprite-map-codegen.ts",
    "codegen-bundle": "npx tsx src/tools/codegen/maps/include-external-tilesets.ts && npx tsx src/tools/codegen/maps/map-bundle-codegen.ts",
    "create-client-system": "npx tsx src/tools/codegen/ecs/client-system-codegen.ts"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/colyseus/create-colyseus/issues"
  },
  "homepage": "https://github.com/colyseus/create-colyseus#readme",
  "devDependencies": {
    "@colyseus/loadtest": "^0.16.1",
    "@colyseus/testing": "^0.16.3",
    "@types/express": "^4.17.1",
    "@types/mocha": "^10.0.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "mocha": "^10.2.0",
    "postcss": "^8.4.48",
    "postcss-import": "^16.1.0",
    "postcss-plugin": "^1.0.0",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.10.2",
    "typescript": "^5.7.3",
    "typescript-plugin-css-modules": "^5.1.0",
    "vite": "6.3.4",
    "vite-plugin-mkcert": "^1.17.6"
  },
  "dependencies": {
    "@colyseus/monitor": "^0.16.7",
    "@colyseus/playground": "^0.16.4",
    "@colyseus/schema": "^3.0.68",
    "@colyseus/tools": "^0.16.8",
    "blueshell": "^5.3.0-addStateDecorateEvent.1",
    "classnames": "^2.5.1",
    "colyseus": "^0.16.5",
    "colyseus.js": "^0.16.22",
    "dotenv": "^16.4.7",
    "easystarjs": "^0.4.4",
    "express": "^4.18.2",
    "install": "^0.13.0",
    "js-event-bus": "^1.1.1",
    "js-logger": "^1.6.1",
    "mongodb": "6.10",
    "nanoid": "^5.0.8",
    "phaser": "^3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
